      <div class="view" id="view-construction">
        <div class="page-head">
          <div class="eyebrow">Step 5 of 10 · Knowledge Graph Construction</div>
          <div class="page-title" id="constructPageTitle">Building the Unified Knowledge Graph</div>
          <div class="page-sub" id="constructPageSub">Entities from your uploaded CSVs and documents are merged into one Neo4j graph. Run each stage in order — plain-language results appear on the right.</div>
        </div>

        <div class="struct-shell">
          <div class="struct-steps" id="constructSteps">
            <!-- filled by JS from uploaded session -->
          </div>
          <aside class="struct-side">
            <div class="struct-results-panel">
              <h4>Construction Results</h4>
              <p class="struct-results-sub">What happened at each stage, explained simply for investigators and business users.</p>
              <button class="btn btn-run-all struct-results-run-all" id="btnRunEntireConstruct" onclick="runEntireConstructPipeline()">▶ Run Entire Pipeline</button>
              <div class="struct-results-feed" id="constructResultsFeed">
                <div class="struct-results-empty" id="constructResultsEmpty">No results yet.<br/>Click <b>Run</b> on Step 1 to begin building the graph from your uploaded files.</div>
              </div>
