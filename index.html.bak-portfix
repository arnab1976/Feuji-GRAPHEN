  <style>
    /* ============================= TOKENS ============================= */
    :root {
      --bg-0: #120907;
      --bg-1: #1A0C0A;
      --bg-2: #24110E;
      --bg-3: #361A15;
      /* Visible borders tuned for dark warm UI (reference-style definition) */
