      <div class="view" id="view-intel">
        <div class="cyph-phase" id="intelPhase">Step 9 of 10 · Intelligence Report</div>
        <div class="page-head" style="margin-bottom:8px">
          <div class="eyebrow">Outcome · User-Specific Intelligence</div>
          <div class="page-title" id="intelTitle">Preparing the intelligence report</div>
          <div class="page-sub" id="intelSubtitle">Synthesizing this session's sources, Cypher outcomes, and cross-document findings.</div>
        </div>
        <div class="intel-actions-bar">
          <div class="crossdoc-meta" style="margin:0">
            <span class="crossdoc-pill" id="intelIndustry">Industry · detecting…</span>
            <span class="crossdoc-pill" id="intelRequirement">Requirement · preparing…</span>
            <span class="crossdoc-pill" id="intelEngine">Report · preparing…</span>
