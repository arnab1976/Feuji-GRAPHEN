              <div class="final-action-brief-title" id="intelBriefTitle">Five Priority Actions</div>
            </div>
            <button type="button" class="btn btn-secondary" onclick="closeIntelligenceReportSummary()">Close</button>
          </div>
          <div class="final-action-brief-intro" id="intelBriefIntro"></div>
          <div class="final-action-brief-list" id="intelBriefActions"></div>
        </section>
        <div id="intelLoading" class="crossdoc-empty">Building a user-specific intelligence report from prior outcomes…</div>
        <div id="intelReportBody" style="display:none">
